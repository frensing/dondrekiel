# PostgREST base URL
API_BASE_URL=https://app.dondrekiel.de/api

# Service role JWT (with role claim: dondrekiel_service)
SERVICE_JWT=

# VAPID details
MAILTO=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Polling interval in milliseconds
POLL_INTERVAL_MS=15000

# Optional: limit how many messages to fetch per poll (helps with large backlogs)
POLL_LIMIT=100
