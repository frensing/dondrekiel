{
  "name": "dondrekiel-push-sender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simple polling-based Web Push sender for Dondrekiel (uses PostgREST).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "generate:vapid": "tsx src/generate-vapid.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
